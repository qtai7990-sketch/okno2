# Скопируйте в .env и заполните. Файл .env никому не пересылать и в GitHub не загружать.
# Секреты сгенерировать: python3 tools/genkeys.py >> server/.env
SIMPAD_DOMAIN=okno.example.ru
SIMPAD_BANK_DOMAIN=bank-okno.example.ru
# IP-адреса банков через пробел (из приложения ИБ к договору), например: 203.0.113.10/32 198.51.100.0/28
SIMPAD_BANK_IPS=127.0.0.1/32
# IP, с которых разрешено администрирование (офис, сам сервер)
SIMPAD_ADMIN_IPS=127.0.0.1/32
POSTGRES_PASSWORD=
# Ключ шифрования персональных данных
SIMPAD_DATA_KEY=
# Отдельный секрет для поиска дублей (HMAC). Не равен SIMPAD_DATA_KEY
SIMPAD_DUP_KEY=
SIMPAD_ADMIN_TOKEN=
# Только для учебного сервера: true разрешает демо-сканер и неутверждённые тексты согласий. На рабочем — false.
SIMPAD_ALLOW_DEMO_SCAN=false
# Запросы банков только с сертификатом mTLS. Отключать нельзя, кроме учебного сервера без банков.
SIMPAD_BANK_MTLS=true
