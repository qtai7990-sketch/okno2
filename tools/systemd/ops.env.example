# /etc/simpad/ops.env — владелец root, права 600 (sudo install -m 600 ops.env.example /etc/simpad/ops.env)
SIMPAD_BACKUP_GPG=<отпечаток открытого ключа gpg, 40 символов>
SIMPAD_BACKUP_BUCKET=<имя бакета Object Storage с версионированием>
AWS_SHARED_CREDENTIALS_FILE=/home/ubuntu/.aws/credentials
AWS_DEFAULT_REGION=ru-central1
SIMPAD_ALERT_TG_TOKEN=<токен бота Telegram>
SIMPAD_ALERT_TG_CHAT=<id чата ответственного>
# Учебный сервер без хранилища: раскомментировать
# SIMPAD_BACKUP_LOCAL_ONLY=1
